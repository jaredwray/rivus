{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/dist",
			"!**/build",
			"!**/coverage",
			"!**/node_modules",
			"!**/.astro",
			"!**/*.astro",
			"!**/.expo",
			"!**/.wrangler",
			"!**/.docula",
			"!**/*.gen.ts",
			"!**/*.svg",
			"!**/openapi.json",
			"!**/worker-configuration.d.ts",
			"!**/expo-env.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.yml", "**/*.yaml", "**/*.md"],
			"formatter": {
				"enabled": false
			}
		}
	]
}
