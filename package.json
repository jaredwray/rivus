{
	"name": "rivus",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Rivus — a modern product platform monorepo (api, website, docs, app).",
	"license": "MIT",
	"author": "Jared Wray (https://jaredwray.com)",
	"homepage": "https://github.com/jaredwray/rivus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredwray/rivus.git"
	},
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"test": "pnpm -r test",
		"test:coverage": "pnpm -r test:coverage",
		"type-check": "pnpm -r type-check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"clean": "pnpm -r clean",
		"services:up": "docker compose up -d",
		"services:down": "docker compose down",
		"services:logs": "docker compose logs -f"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
