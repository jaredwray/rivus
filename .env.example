# Copy to .env and adjust. Never commit a real .env.
# Each app also documents its own variables in its package README.

# --- @rivus/api ---------------------------------------------------------------
# Local docker-compose MongoDB (single-node replica set). For production use your
# MongoDB Atlas SRV connection string.
MONGODB_URI=mongodb://localhost:27017/rivus?replicaSet=rs0&directConnection=true
# Secret used to sign JWT access tokens. In production this MUST be a strong
# value of at least 32 characters — the API refuses to boot otherwise.
JWT_SECRET=dev-secret-change-me
# Allowed CORS origin. Defaults to "*"; set an explicit origin in production.
CORS_ORIGIN=*
# Port the Fastify API listens on.
API_PORT=4000
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
NODE_ENV=development
# Resend API key for transactional email (invitations). When unset, the API
# still runs but invitation emails are not delivered.
# RESEND_API_KEY=re_xxxxxxxx
# The "from" address for outbound email. The domain must be verified in Resend.
EMAIL_FROM=Rivus <hello@rivus.ai>
# Base URL of the app; used to build the accept link in invitation emails.
APP_URL=https://app.rivus.ai
# --- Agent email channel (scheduling over email) ------------------------------
# Customers email <account-slug>@riv.us and Rivus books appointments over email.
# Domain of those per-account agent addresses. Must be configured as an inbound
# (receiving) domain in Resend, with an `email.received` webhook pointing at
# POST /v1/channels/email/inbound.
AGENT_EMAIL_DOMAIN=riv.us
# Svix signing secret for that webhook (Resend → Webhooks → signing secret).
# When unset, dev/test accept unsigned deliveries so you can drive the flow with
# curl; production refuses the webhook route (503) until it's set.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# Base URL of the marketing website; used to build the customer self-signup link
# (/customers/join/<slug>) the agent emails to unrecognized senders.
WEBSITE_URL=https://rivus.ai
# --- WhatsApp channel (zernio) ------------------------------------------------
# Rivus assigns a WhatsApp Business number (via zernio) when an owner enables the
# channel in settings, then answers over WhatsApp with the same scheduling agent
# as email. zernio posts inbound messages to POST /v1/channels/whatsapp/inbound.
# Base URL of the zernio API.
ZERNIO_API_URL=https://api.zernio.com
# zernio API key. When unset, WhatsApp degrades to a no-op sender + provisioner
# (a deterministic fake number in development) so the API runs without credentials.
# ZERNIO_API_KEY=zk_xxxxxxxx
# Signing secret for zernio's inbound webhook. When unset, dev/test accept unsigned
# deliveries so you can drive the flow with curl; production refuses the webhook
# route (503) until it's set.
# ZERNIO_WEBHOOK_SECRET=whsec_xxxxxxxx
# Verify token for the GET webhook-registration handshake. When unset, that
# handshake endpoint 404s.
# ZERNIO_VERIFY_TOKEN=
# AI knowledge-base features: the duplicate-FAQ check (run before "Add FAQ") and
# answering visitors' questions from the FAQs (the agent's catch-all). Both run
# through the AI SDK, so any provider whose key is set can serve them — OpenAI is
# the primary, the rest are backups (tried in order). When no key is set, the
# duplicate check is a no-op and question-answering degrades to a deterministic
# keyword match over the FAQs.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.4-mini
# GOOGLE_GENERATIVE_AI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4-fast
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
# Embedding model for semantic FAQ retrieval. Once an account's knowledge base grows
# past the answerer's candidate cap, the question and FAQs are embedded and the most
# *relevant* FAQs (not just the newest) are sent to the model. Query and FAQs must use
# the same model, so retrieval uses one provider: OpenAI when its key is set, else
# Google. Without either key, the answerer keeps its newest-first behavior.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GOOGLE_EMBEDDING_MODEL=text-embedding-004

# --- @rivus/website -----------------------------------------------------------
# Base URL the marketing site uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- @rivus/agent -------------------------------------------------------------
# The agent runs on the Workers runtime via `wrangler dev`, which serves it on
# http://localhost:8787 by default. No secrets are required for the hello
# milestone; add provider keys here when the agent starts calling a model.

# --- @rivus/app ---------------------------------------------------------------
# Base URL the Expo app uses to reach the API.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Base URL the Expo app uses to reach the Rivus agent (wrangler dev default).
EXPO_PUBLIC_AGENT_URL=http://localhost:8787
# Optional JWT for the app's Items screen to preview authenticated data.
# EXPO_PUBLIC_DEMO_TOKEN=
# Google Maps Platform key for signup address autocomplete (Places API New).
# Inlined into the client bundle, so restrict it by HTTP referrer + API in the
# Google Cloud console. When unset, the address field is a plain text input.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
