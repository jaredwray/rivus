{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rivus-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-01",
	"observability": {
		"enabled": true
	},
	// Dev default — override per-environment (e.g. an `env.production` block) or
	// at deploy time so scheduled tasks target the real API rather than localhost.
	"vars": {
		"API_BASE_URL": "http://localhost:4000"
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
}
