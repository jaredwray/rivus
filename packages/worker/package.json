{
	"name": "@rivus/worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Rivus Cloudflare Worker — scheduled and on-demand background tasks.",
	"license": "MIT",
	"scripts": {
		"dev": "wrangler dev",
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist coverage .wrangler"
	},
	"dependencies": {
		"@rivus/core": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@faker-js/faker": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
