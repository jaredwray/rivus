{
	"name": "@rivus/website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Rivus marketing site — Astro with React islands.",
	"license": "MIT",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"start": "astro preview",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist .astro coverage"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.0",
		"@rivus/core": "workspace:*",
		"astro": "^7.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@faker-js/faker": "catalog:",
		"@testing-library/react": "^16.3.0",
		"@types/node": "catalog:",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitest/coverage-v8": "catalog:",
		"jsdom": "^29.1.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
