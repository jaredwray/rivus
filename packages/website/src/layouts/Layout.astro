---
import '../styles/globals.css';
import { isProductionEnv } from '../lib/env';
import type { PageMeta } from '../lib/meta';
import { siteConfig } from '../lib/site';
import { baseUrl } from '../lib/sitemap';

type Props = PageMeta;

const { title, description, canonical, robots, openGraph } = Astro.props;
const production = isProductionEnv();
const noindex = !production || robots?.index === false;
const canonicalHref = canonical ? new URL(canonical, `${baseUrl}/`).href : undefined;
const ogTitle = openGraph?.title ?? title;
const ogDescription = openGraph?.description ?? description;
const ogUrl = openGraph?.url
	? new URL(openGraph.url, `${baseUrl}/`).href
	: canonicalHref;
const ogImage = `${baseUrl}/opengraph-image.png`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#6e1ec8" />
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
		{canonicalHref ? <link rel="canonical" href={canonicalHref} /> : null}
		<meta property="og:type" content={openGraph?.type ?? 'website'} />
		<meta property="og:site_name" content={openGraph?.siteName ?? siteConfig.name} />
		<meta property="og:locale" content={openGraph?.locale ?? 'en_US'} />
		<meta property="og:title" content={ogTitle} />
		{ogDescription ? <meta property="og:description" content={ogDescription} /> : null}
		{ogUrl ? <meta property="og:url" content={ogUrl} /> : null}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={siteConfig.tagline} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		{ogDescription ? <meta name="twitter:description" content={ogDescription} /> : null}
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" href="/icon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
