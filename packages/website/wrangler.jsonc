{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rivus-website",
	"compatibility_date": "2026-06-01",
	// Assets-only Worker: no `main`, Cloudflare serves the static Astro build
	// directly. `pnpm --filter @rivus/website build` emits the site into ./dist.
	"assets": {
		"directory": "./dist",
		// Match Astro `trailingSlash: "never"` so `/about` is the canonical URL
		// (sitemap/canonicals have no trailing slash). `auto-trailing-slash`
		// 307'd `/customers/join/:slug` onto `/customers/join/` and dropped the
		// slug the join island reads from the visible path.
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},
	// `assets` is inherited; a named environment only needs to override the
	// Worker name and bind its custom domain. Deploy: `wrangler deploy --env development`.
	"env": {
		"development": {
			"name": "rivus-website-dev",
			"routes": [{ "pattern": "dev.rivus.ai", "custom_domain": true }]
		},
		"production": {
			"name": "rivus-website",
			// `rivus.ai` is the primary; `www.rivus.ai` is served too (a Cloudflare
			// redirect rule points www → apex, configured outside this repo).
			"routes": [
				{ "pattern": "rivus.ai", "custom_domain": true },
				{ "pattern": "www.rivus.ai", "custom_domain": true }
			]
		}
	}
}
