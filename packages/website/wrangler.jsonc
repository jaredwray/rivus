{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rivus-website",
	// Generated by the OpenNext Cloudflare adapter (`opennextjs-cloudflare build`).
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// `assets` and `compatibility_flags` are inherited; the development
	// environment only overrides the Worker name and its custom domain.
	"env": {
		"development": {
			"name": "rivus-website-dev",
			"routes": [{ "pattern": "dev.rivus.ai", "custom_domain": true }]
		},
		"production": {
			"name": "rivus-website",
			// `rivus.ai` is the primary; `www.rivus.ai` is served too (a Cloudflare
			// redirect rule points www → apex, configured outside this repo).
			"routes": [
				{ "pattern": "rivus.ai", "custom_domain": true },
				{ "pattern": "www.rivus.ai", "custom_domain": true }
			]
		}
	}
}
