{
	"name": "@rivus/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Shared domain types, Zod schemas, and utilities for Rivus.",
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist coverage"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@faker-js/faker": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
