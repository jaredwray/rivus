{
	"name": "@rivus/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Rivus documentation site — docs, changelog, and API reference, built with Docula.",
	"license": "MIT",
	"scripts": {
		"prebuild": "node scripts/sync-openapi.mjs",
		"build": "docula build -s ./site -o ./site/dist -c",
		"predev": "node scripts/sync-openapi.mjs",
		"dev": "docula dev -s ./site",
		"start": "docula start -s ./site",
		"sync-openapi": "node scripts/sync-openapi.mjs",
		"deploy": "wrangler deploy",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf site/dist"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"docula": "^2.0.0",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	}
}
