{
	"name": "@rivus/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Rivus REST API — Fastify on MongoDB Atlas (Mongoose) with JWT auth.",
	"license": "MIT",
	"main": "./dist/index.mjs",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsdown",
		"start": "node dist/index.mjs",
		"openapi": "tsx src/openapi.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist coverage"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/jwt": "^10.1.0",
		"@fastify/sensible": "^6.0.4",
		"@fastify/swagger": "^9.7.0",
		"@fastify/swagger-ui": "^6.0.0",
		"@rivus/core": "workspace:*",
		"close-with-grace": "^2.5.0",
		"fastify": "^5.8.5",
		"fastify-plugin": "^6.0.0",
		"fastify-type-provider-zod": "^6.1.0",
		"mongoose": "^9.7.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@faker-js/faker": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"pino-pretty": "^13.1.3",
		"tsdown": "catalog:",
		"tsx": "^4.22.4",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
