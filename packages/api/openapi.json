{
  "openapi": "3.0.3",
  "info": {
    "title": "Rivus API",
    "description": "REST API for Rivus.",
    "version": "0.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
